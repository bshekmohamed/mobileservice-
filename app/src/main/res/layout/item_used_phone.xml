<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:strokeColor="@color/brand_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_phone_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Samsung Galaxy A53"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/brand_on_surface"/>
                <TextView
                    android:id="@+id/tv_phone_specs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="128GB • 6GB • Black"
                    android:textSize="12sp"
                    android:textColor="@color/brand_on_surface_muted"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">
                <TextView
                    android:id="@+id/tv_grade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A+"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/grade_aplus"/>
                <TextView
                    android:id="@+id/tv_status_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In Stock"
                    android:textSize="11sp"
                    android:textColor="@color/brand_primary"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">
            <TextView
                android:id="@+id/tv_buy_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Buy: ₹0"
                android:textSize="12sp"
                android:textColor="@color/brand_on_surface_muted"/>
            <TextView
                android:id="@+id/tv_sell_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sell: ₹0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/brand_primary"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/brand_divider"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_phone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Edit"
                android:textSize="11sp"
                app:strokeColor="@color/brand_divider"
                android:textColor="@color/brand_on_surface_muted"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_sell_phone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Sell"
                android:textSize="11sp"
                app:strokeColor="@color/brand_primary"
                android:textColor="@color/brand_primary"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_whatsapp_phone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="WA"
                android:textSize="11sp"
                app:strokeColor="#25D366"
                android:textColor="#25D366"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_phone"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="🗑"
                android:textSize="14sp"
                app:strokeColor="#7F1D1D"
                android:textColor="#F87171"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
