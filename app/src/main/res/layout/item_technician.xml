<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="@color/brand_surface_card"
    app:strokeColor="@color/brand_divider"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="👨‍🔧"
            android:textSize="22sp"
            android:gravity="center"
            android:background="@color/brand_surface_elevated"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_tech_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Technician Name"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/brand_on_surface"/>
            <TextView
                android:id="@+id/tv_tech_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No phone"
                android:textSize="12sp"
                android:textColor="@color/brand_primary"/>
            <TextView
                android:id="@+id/tv_tech_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:textSize="11sp"
                android:textColor="@color/brand_on_surface_muted"/>
            <TextView
                android:id="@+id/tv_tech_branch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mimisal"
                android:textSize="11sp"
                android:textColor="@color/brand_on_surface_muted"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_tech_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_more"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/brand_on_surface_muted"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
